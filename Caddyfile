flywithpeggs.com {
    redir /mediakit /peggens_altidor_media_kit.pdf permanent
    reverse_proxy web:80
    encode gzip zstd

    header {
        # Security headers
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }
}

http://www.flywithpeggs.com {
    redir https://flywithpeggs.com{uri} permanent
}

bgtravelnetwork.com, www.bgtravelnetwork.com {
    reverse_proxy host.docker.internal:8080
    encode gzip zstd
}

